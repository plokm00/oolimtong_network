rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can read and create only their own public profile.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Nicknames are reserved by a small lookup document. The record can only
    // be created for the currently authenticated Firebase user.
    match /userNicknames/{nickname} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
